// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SISWA
  PEGAWAI
  PENGAJAR
  ADMIN
}

enum AttendanceStatus {
  HADIR
  TELAT
  IZIN
  SAKIT
  ALPHA
}

model User {
  id          Int       @id @default(autoincrement())
  NIP         String    @unique
  password    String    // hashed password
  fullName    String
  email       String?   @unique
  phone       String?
  role        Role      @default(SISWA)
  isActive    Boolean   @default(true)
  avatarUrl   String?
  // relations
  attendances Attendance[]
  auditLog    AuditLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role])
}

model Attendance {
  id              Int              @id @default(autoincrement())
  user            User             @relation(fields: [userId], references: [id])
  userId          Int
  date            DateTime         // date of attendance (store at midnight UTC or use date-only semantics)
  checkInAt       DateTime?        // timestamp when user pressed Absen Masuk
  checkInGeoLat   Float?          // optional geolocation latitude for check-in
  checkInGeoLng   Float?          // optional geolocation longitude for check-in
  checkInNote     String?          // optional note (e.g., lokasi, device)
  checkOutAt      DateTime?        // timestamp when user pressed Absen Pulang
  checkOutGeoLat  Float?
  checkOutGeoLng  Float?
  checkOutNote    String?
  status          AttendanceStatus @default(HADIR)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, date])
  @@index([date])
  @@unique([userId, date]) // one attendance record per user per date
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  userId    Int  // optional foreign key if you want to point to User (not enforced here)
  user      User      @relation(fields: [userId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime  @default(now())
}
